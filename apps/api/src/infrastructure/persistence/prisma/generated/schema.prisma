// Prisma schema для Release 1
// Основано на docs/Модель-данных.md
// FEAT-PLT-02: полная схема БД для всех доменов

generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/persistence/prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. Identity & Access
// ============================================

enum UserStatus {
  active
  blocked
  deleted
}

enum RoleCode {
  owner
  assistant
  editor
  client
}

enum RoleScope {
  admin
  product
}

enum ConsentType {
  personal_data
  communications
  telegram
  review_publication
}

model User {
  id               String     @id @default(uuid())
  email            String?    @unique // P1, unique nullable
  phone            String?    @unique // P1, unique nullable
  telegramUserId   String?    @unique @map("telegram_user_id") // P1, unique nullable
  telegramUsername String?    @map("telegram_username") // P1 nullable
  displayName      String?    @map("display_name") // P1 nullable
  passwordHash     String?    @map("password_hash") // nullable, только для админов
  status           UserStatus @default(active)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  // Relations
  userRoles               UserRole[]
  consents                Consent[]
  sessions                Session[]
  contentItems            ContentItem[]            @relation("ContentAuthor")
  appointments            Appointment[]
  diaryEntries            DiaryEntry[]
  dataExportRequests      DataExportRequest[]
  interactiveRuns         InteractiveRun[]
  waitlistRequests        WaitlistRequest[]
  anonymousQuestions      AnonymousQuestion[]
  reviews                 Review[]
  questionAnswers         QuestionAnswer[]
  moderationActions       UgcModerationAction[]
  auditLogEntries         AuditLogEntry[]
  messageTemplateVersions MessageTemplateVersion[]
  leadIdentities          LeadIdentity[]

  @@map("users")
}

model Role {
  code  RoleCode  @id
  scope RoleScope

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id")
  roleCode  RoleCode @map("role_code")
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Cascade)

  @@id([userId, roleCode])
  @@map("user_roles")
}

model Consent {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  consentType ConsentType @map("consent_type")
  granted     Boolean
  version     String // например, "2026-01-07"
  source      String // web|telegram|admin
  grantedAt   DateTime?   @map("granted_at")
  revokedAt   DateTime?   @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consents")
}

model Session {
  id        String   @id @db.VarChar(255)
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================
// 2. Content (CMS, темы/теги, подборки, словарь, медиа)
// ============================================

enum ContentType {
  article
  note
  resource
  landing
  page
}

enum ContentStatus {
  draft
  review
  published
  archived
}

enum TimeToBenefit {
  one_to_three_min     @map("_1_3_min")
  seven_to_ten_min     @map("_7_10_min")
  twenty_to_thirty_min @map("_20_30_min")
  series
}

enum ContentFormat {
  article
  note
  resource
  audio
  checklist
}

enum SupportLevel {
  self_help
  micro_support
  consultation
}

enum CollectionType {
  problem
  format
  goal
  context
}

enum GlossaryCategory {
  approach
  state
  concept
}

enum LinkType {
  mentioned_in
  recommended
}

model ContentItem {
  id              String         @id @default(uuid())
  contentType     ContentType    @map("content_type")
  slug            String
  title           String
  excerpt         String?
  bodyMarkdown    String?        @map("body_markdown")
  status          ContentStatus  @default(draft)
  publishedAt     DateTime?      @map("published_at")
  authorUserId    String?        @map("author_user_id")
  timeToBenefit   TimeToBenefit? @map("time_to_benefit")
  format          ContentFormat?
  supportLevel    SupportLevel?  @map("support_level")
  metaTitle       String?        @map("meta_title")
  metaDescription String?        @map("meta_description")
  canonicalUrl    String?        @map("canonical_url")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  author        User?              @relation("ContentAuthor", fields: [authorUserId], references: [id])
  topics        ContentItemTopic[]
  tags          ContentItemTag[]
  media         ContentMedia[]
  curatedItems  CuratedItem[]
  glossaryLinks GlossaryTermLink[]

  revisions ContentRevision[]

  @@unique([contentType, slug])
  @@map("content_items")
}

model ContentRevision {
  id              String   @id @default(uuid())
  contentItemId   String   @map("content_item_id")
  bodyMarkdown    String?  @map("body_markdown")
  meta            Json? // дополнительные метаданные (title, excerpt, metaTitle, etc.)
  changedByUserId String?  @map("changed_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId, createdAt(sort: Desc)])
  @@map("content_revisions")
}

model Topic {
  code     String  @id // anxiety|burnout|relationships|boundaries|selfesteem|...
  title    String
  isActive Boolean @default(true) @map("is_active")

  contentItems           ContentItemTopic[]
  interactiveDefinitions InteractiveDefinition[]
  curatedCollections     CuratedCollection[]
  leads                  Lead[]
  deepLinks              DeepLink[]

  @@map("topics")
}

model ContentItemTopic {
  contentItemId String @map("content_item_id")
  topicCode     String @map("topic_code")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  topic       Topic       @relation(fields: [topicCode], references: [code], onDelete: Cascade)

  @@id([contentItemId, topicCode])
  @@map("content_item_topics")
}

model Tag {
  id    String @id @default(uuid())
  slug  String @unique
  title String

  contentItems ContentItemTag[]

  @@map("tags")
}

model ContentItemTag {
  contentItemId String @map("content_item_id")
  tagId         String @map("tag_id")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentItemId, tagId])
  @@map("content_item_tags")
}

model MediaAsset {
  id               String   @id @default(uuid())
  storageProvider  String   @default("s3") @map("storage_provider")
  objectKey        String   @unique @map("object_key")
  publicUrl        String   @map("public_url")
  mediaType        String   @map("media_type") // image|audio|pdf
  mimeType         String   @map("mime_type")
  sizeBytes        BigInt   @map("size_bytes")
  title            String?
  altText          String?  @map("alt_text")
  uploadedByUserId String?  @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  contentItems ContentMedia[]

  @@map("media_assets")
}

model ContentMedia {
  contentItemId String @map("content_item_id")
  mediaAssetId  String @map("media_asset_id")
  usage         String // cover|inline|attachment|audio

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([contentItemId, mediaAssetId])
  @@map("content_media")
}

model CuratedCollection {
  id             String         @id @default(uuid())
  slug           String         @unique
  title          String
  collectionType CollectionType @map("collection_type")
  status         ContentStatus  @default(draft)
  topicCode      String?        @map("topic_code")
  publishedAt    DateTime?      @map("published_at")

  topic Topic?        @relation(fields: [topicCode], references: [code])
  items CuratedItem[]

  @@map("curated_collections")
}

model CuratedItem {
  id                      String  @id @default(uuid())
  collectionId            String  @map("collection_id")
  itemType                String  @map("item_type") // content|interactive
  contentItemId           String? @map("content_item_id")
  interactiveDefinitionId String? @map("interactive_definition_id")
  position                Int
  note                    String?

  collection            CuratedCollection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contentItem           ContentItem?           @relation(fields: [contentItemId], references: [id])
  interactiveDefinition InteractiveDefinition? @relation(fields: [interactiveDefinitionId], references: [id])

  @@map("curated_items")
}

model GlossaryTerm {
  id              String           @id @default(uuid())
  slug            String           @unique
  title           String
  category        GlossaryCategory
  shortDefinition String           @map("short_definition")
  bodyMarkdown    String?          @map("body_markdown")
  status          ContentStatus    @default(draft)
  publishedAt     DateTime?        @map("published_at")

  synonyms GlossaryTermSynonym[]
  links    GlossaryTermLink[]

  @@map("glossary_terms")
}

model GlossaryTermSynonym {
  id      String @id @default(uuid())
  termId  String @map("term_id")
  synonym String

  term GlossaryTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@map("glossary_term_synonyms")
}

model GlossaryTermLink {
  id            String   @id @default(uuid())
  termId        String   @map("term_id")
  contentItemId String   @map("content_item_id")
  linkType      LinkType @map("link_type")

  term        GlossaryTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  contentItem ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@map("glossary_term_links")
}

// ============================================
// 3. Interactive (определения интерактивов + агрегированные результаты)
// ============================================

enum InteractiveType {
  quiz
  navigator
  thermometer
  boundaries
  prep
  ritual
}

model InteractiveDefinition {
  id              String          @id @default(uuid())
  interactiveType InteractiveType @map("interactive_type")
  slug            String
  title           String
  topicCode       String?         @map("topic_code")
  status          ContentStatus   @default(draft)
  publishedAt     DateTime?       @map("published_at")

  topic        Topic?           @relation(fields: [topicCode], references: [code])
  runs         InteractiveRun[]
  curatedItems CuratedItem[]

  @@unique([interactiveType, slug])
  @@map("interactive_definitions")
}

enum ResultLevel {
  low
  moderate
  high
}

model InteractiveRun {
  id                      String       @id @default(uuid())
  interactiveDefinitionId String       @map("interactive_definition_id")
  userId                  String?      @map("user_id")
  anonymousId             String?      @map("anonymous_id") // P0
  startedAt               DateTime     @map("started_at")
  completedAt             DateTime?    @map("completed_at")
  resultLevel             ResultLevel? @map("result_level")
  resultProfile           String?      @map("result_profile") // nullable (navigator)
  durationMs              Int?         @map("duration_ms")
  crisisTriggered         Boolean      @default(false) @map("crisis_triggered")
  crisisTriggerType       String?      @map("crisis_trigger_type") // nullable
  deepLinkId              String?      @map("deep_link_id")

  interactiveDefinition InteractiveDefinition @relation(fields: [interactiveDefinitionId], references: [id], onDelete: Cascade)
  user                  User?                 @relation(fields: [userId], references: [id])
  deepLink              DeepLink?             @relation(fields: [deepLinkId], references: [id])

  @@map("interactive_runs")
}

// ============================================
// 4. Booking & Payments
// ============================================

enum ServiceFormat {
  online
  offline
  hybrid
}

enum AppointmentStatus {
  pending_payment
  paid
  confirmed
  canceled
  rescheduled
  completed
}

enum PaymentProvider {
  yookassa
}

enum PaymentStatus {
  pending
  succeeded
  canceled
  failed
}

enum IntakeFormStatus {
  draft
  submitted
}

enum WaitlistStatus {
  new
  contacted
  closed
}

model Service {
  id                  String        @id @default(uuid())
  slug                String        @unique
  title               String
  descriptionMarkdown String?       @map("description_markdown")
  format              ServiceFormat
  durationMinutes     Int           @map("duration_minutes")
  priceAmount         Int           @map("price_amount") // RUB
  depositAmount       Int?          @map("deposit_amount")
  cancelFreeHours     Int?          @map("cancel_free_hours")
  status              ContentStatus @default(draft)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  appointments      Appointment[]
  availabilitySlots AvailabilitySlot[]
  waitlistRequests  WaitlistRequest[]

  @@map("services")
}

model AvailabilitySlot {
  id              String   @id @default(uuid())
  serviceId       String?  @map("service_id")
  startAtUtc      DateTime @map("start_at_utc")
  endAtUtc        DateTime @map("end_at_utc")
  status          String // available|reserved|blocked
  source          String // product|google_calendar
  externalEventId String?  @map("external_event_id")
  createdAt       DateTime @default(now()) @map("created_at")

  service      Service?      @relation(fields: [serviceId], references: [id])
  appointments Appointment[]

  @@index([startAtUtc, status])
  @@index([source])
  @@map("availability_slots")
}

model Appointment {
  id                      String            @id @default(uuid())
  serviceId               String            @map("service_id")
  clientUserId            String?           @map("client_user_id")
  leadId                  String?           @map("lead_id")
  startAtUtc              DateTime          @map("start_at_utc")
  endAtUtc                DateTime          @map("end_at_utc")
  timezone                String // IANA
  format                  ServiceFormat
  status                  AppointmentStatus @default(pending_payment)
  meetingUrl              String?           @map("meeting_url")
  locationText            String?           @map("location_text")
  slotId                  String?           @map("slot_id")
  externalCalendarEventId String?           @map("external_calendar_event_id")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  service    Service           @relation(fields: [serviceId], references: [id])
  client     User?             @relation(fields: [clientUserId], references: [id])
  slot       AvailabilitySlot? @relation(fields: [slotId], references: [id])
  payments   Payment[]
  intakeForm IntakeForm?

  @@index([startAtUtc])
  @@index([status])
  @@map("appointments")
}

model Payment {
  id                String          @id @default(uuid())
  appointmentId     String          @map("appointment_id")
  provider          PaymentProvider @default(yookassa)
  providerPaymentId String          @unique @map("provider_payment_id")
  amount            Int
  currency          String          @default("RUB")
  status            PaymentStatus   @default(pending)
  failureCategory   String?         @map("failure_category")
  createdAt         DateTime        @default(now()) @map("created_at")
  confirmedAt       DateTime?       @map("confirmed_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@map("payments")
}

model IntakeForm {
  id               String           @id @default(uuid())
  appointmentId    String           @unique @map("appointment_id")
  status           IntakeFormStatus @default(draft)
  payloadEncrypted String           @map("payload_encrypted") // P2
  submittedAt      DateTime?        @map("submitted_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("intake_forms")
}

model WaitlistRequest {
  id                    String         @id @default(uuid())
  userId                String?        @map("user_id")
  serviceId             String         @map("service_id")
  preferredContact      String         @map("preferred_contact") // email|phone|telegram
  contactValueEncrypted String?        @map("contact_value_encrypted") // P1
  preferredTimeWindow   String?        @map("preferred_time_window")
  status                WaitlistStatus @default(new)
  createdAt             DateTime       @default(now()) @map("created_at")

  user    User?   @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("waitlist_requests")
}

// ============================================
// 5. Client Cabinet (дневники, экспорт PDF)
// ============================================

enum DiaryType {
  emotions
  abc
  sleep_energy
  gratitude
}

enum ExportType {
  user_data
  diary_pdf
}

enum ExportStatus {
  requested
  processing
  ready
  failed
}

model DiaryEntry {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  diaryType        DiaryType @map("diary_type")
  entryDate        DateTime  @map("entry_date") @db.Date
  payloadEncrypted String    @map("payload_encrypted") // P2
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("diary_entries")
}

model DataExportRequest {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  exportType  ExportType   @map("export_type")
  status      ExportStatus @default(requested)
  fileUrl     String?      @map("file_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("data_export_requests")
}

// ============================================
// 6. Telegram & Deep Links
// ============================================

enum DeepLinkFlow {
  plan_7d
  save_resource
  challenge_7d
  concierge
  question
  prep
  ritual
  boundaries
  favorites
}

model DeepLink {
  id          String       @id @db.VarChar(255) // base62, не UUID
  flow        DeepLinkFlow
  topicCode   String?      @map("topic_code")
  entityRef   String?      @map("entity_ref")
  sourcePage  String?      @map("source_page")
  anonymousId String?      @map("anonymous_id")
  leadId      String?      @map("lead_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  expiresAt   DateTime?    @map("expires_at") // TTL=30d

  topic           Topic?              @relation(fields: [topicCode], references: [code])
  lead            Lead?               @relation(fields: [leadId], references: [id])
  interactiveRuns InteractiveRun[]
  timelineEvents  LeadTimelineEvent[]

  @@index([createdAt])
  @@map("deep_links")
}

// ============================================
// 7. CRM & Analytics
// ============================================

enum LeadStatus {
  new
  engaged
  booking_started
  booked_confirmed
  paid
  completed_session
  follow_up_needed
  inactive
}

enum LeadSource {
  quiz
  telegram
  waitlist
  question
  booking
}

model Lead {
  id        String     @id @default(uuid())
  status    LeadStatus @default(new)
  source    LeadSource
  topicCode String?    @map("topic_code")
  utm       Json? // nullable, P0-only
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  topic          Topic?              @relation(fields: [topicCode], references: [code])
  identities     LeadIdentity[]
  timelineEvents LeadTimelineEvent[]
  deepLinks      DeepLink[]

  @@map("leads")
}

model LeadIdentity {
  id             String   @id @default(uuid())
  leadId         String   @map("lead_id")
  userId         String?  @map("user_id")
  anonymousId    String?  @map("anonymous_id")
  emailEncrypted String?  @map("email_encrypted") // nullable, P1
  phoneEncrypted String?  @map("phone_encrypted") // nullable, P1
  telegramUserId String?  @map("telegram_user_id") // nullable, P1
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@map("lead_identities")
}

model LeadTimelineEvent {
  id         String   @id @default(uuid())
  leadId     String   @map("lead_id")
  eventName  String   @map("event_name") // из Tracking Plan
  source     String // web|backend|telegram|admin
  occurredAt DateTime @map("occurred_at")
  deepLinkId String?  @map("deep_link_id")
  properties Json? // P0-only, без PII/текстов

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deepLink DeepLink? @relation(fields: [deepLinkId], references: [id])

  @@index([leadId, occurredAt])
  @@map("lead_timeline_events")
}

// ============================================
// 8. UGC Moderation
// ============================================

enum QuestionStatus {
  pending
  flagged
  approved
  answered
  rejected
}

enum ReviewStatus {
  draft
  pending
  published
  unpublished
}

enum AnonymityLevel {
  full
  initials
  named
}

enum ModerationActionType {
  approve
  reject
  flag
  mask_pii
  publish
  unpublish
  escalate
}

enum ModerationReasonCategory {
  crisis
  medical
  out_of_scope
  therapy_request
  spam
  pii
  other
}

enum UgcType {
  anonymous_question
  review
  comment
}

model AnonymousQuestion {
  id                    String         @id @default(uuid())
  userId                String?        @map("user_id")
  status                QuestionStatus @default(pending)
  triggerFlags          String?        @map("trigger_flags") // nullable (crisis|pii|medical|spam)
  questionTextEncrypted String         @map("question_text_encrypted") // P2
  contactValueEncrypted String?        @map("contact_value_encrypted") // nullable, P1
  publishAllowed        Boolean        @default(false) @map("publish_allowed")
  submittedAt           DateTime       @default(now()) @map("submitted_at")
  answeredAt            DateTime?      @map("answered_at")

  user    User?            @relation(fields: [userId], references: [id])
  answers QuestionAnswer[]

  @@index([status, submittedAt])
  @@map("anonymous_questions")
}

model QuestionAnswer {
  id                  String    @id @default(uuid())
  questionId          String    @map("question_id")
  answeredByUserId    String    @map("answered_by_user_id")
  answerTextEncrypted String    @map("answer_text_encrypted") // P2
  publishedAt         DateTime? @map("published_at")

  question   AnonymousQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answeredBy User              @relation(fields: [answeredByUserId], references: [id])

  @@map("question_answers")
}

model Review {
  id                  String         @id @default(uuid())
  userId              String?        @map("user_id")
  status              ReviewStatus   @default(draft)
  reviewTextEncrypted String         @map("review_text_encrypted") // P2
  anonymityLevel      AnonymityLevel @map("anonymity_level")
  submittedAt         DateTime       @default(now()) @map("submitted_at")
  publishedAt         DateTime?      @map("published_at")

  user     User?                      @relation(fields: [userId], references: [id])
  consents ReviewPublicationConsent[]

  @@map("reviews")
}

model ReviewPublicationConsent {
  id        String    @id @default(uuid())
  reviewId  String    @map("review_id")
  userId    String?   @map("user_id")
  granted   Boolean
  version   String
  grantedAt DateTime? @map("granted_at")
  revokedAt DateTime? @map("revoked_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_publication_consents")
}

model UgcModerationAction {
  id              String                   @id @default(uuid())
  ugcType         UgcType                  @map("ugc_type")
  ugcId           String                   @map("ugc_id") // может ссылаться на anonymous_question, review и т.д.
  moderatorUserId String                   @map("moderator_user_id")
  action          ModerationActionType
  reasonCategory  ModerationReasonCategory @map("reason_category")
  createdAt       DateTime                 @default(now()) @map("created_at")

  moderator User @relation(fields: [moderatorUserId], references: [id])

  @@index([ugcType, ugcId, createdAt])
  @@map("ugc_moderation_actions")
}

// ============================================
// 9. Admin & Audit
// ============================================

enum MessageChannel {
  email
  telegram
}

enum MessageCategory {
  booking
  waitlist
  event
  moderation
}

model AuditLogEntry {
  id          String   @id @default(uuid())
  actorUserId String   @map("actor_user_id")
  actorRole   String   @map("actor_role") // owner|assistant|editor
  action      String // admin_price_changed|admin_data_exported|...
  entityType  String   @map("entity_type") // service|content|lead|user|payment|...
  entityId    String?  @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId], map: "idx_audit_log_actor_user_id")
  @@index([createdAt(sort: Desc)], map: "idx_audit_log_created_at")
  @@index([action], map: "idx_audit_log_action")
  @@index([entityType, entityId], map: "idx_audit_log_entity")
  @@index([actorUserId, createdAt(sort: Desc)], map: "idx_audit_log_user_time")
  @@map("audit_log_entries")
}

model MessageTemplate {
  id        String          @id @default(uuid())
  channel   MessageChannel
  category  MessageCategory
  name      String
  status    ContentStatus   @default(draft)
  createdAt DateTime        @default(now()) @map("created_at")

  versions MessageTemplateVersion[]

  @@map("message_templates")
}

model MessageTemplateVersion {
  id              String   @id @default(uuid())
  templateId      String   @map("template_id")
  version         Int
  subject         String?
  bodyMarkdown    String   @map("body_markdown")
  updatedByUserId String   @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  template  MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  updatedBy User            @relation(fields: [updatedByUserId], references: [id])

  @@map("message_template_versions")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique // например, "google_calendar_enabled", "yookassa_shop_id"
  value     Json? // значение настройки (может быть string, number, boolean, object)
  category  String? // profile|integrations|telegram|yookassa|general
  updatedBy String?  @map("updated_by") // user_id (nullable, для аудита)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}
