{
  "name": "@emotional-balance/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/presentation/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/presentation/http/server.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "migrate:create": "prisma migrate dev --name",
    "migrate:up": "prisma migrate deploy --schema=prisma/schema.prisma",
    "migrate:down": "prisma migrate resolve --rolled-back",
    "migrate:reset": "prisma migrate reset --schema=prisma/schema.prisma",
    "migrate:status": "prisma migrate status --schema=prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/rate-limit": "^8.0.0",
    "@prisma/client": "^6.1.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.6.1",
    "fastify": "^4.29.1",
    "marked": "^9.1.6",
    "pino": "^9.9.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "prisma": "^6.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^1.6.1"
  }
}
